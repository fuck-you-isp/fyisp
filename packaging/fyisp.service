# systemd unit for fyisp. Install:
#   sudo install -m 0755 fyisp-linux-amd64 /usr/local/bin/fyisp
#   sudo install -m 0644 fyisp.service /etc/systemd/system/fyisp.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now fyisp
# Open the sign-in link (see the admin token below). Data lives in /var/lib/fyisp (StateDirectory);
# `sudo systemctl stop fyisp && sudo rm -rf /var/lib/private/fyisp` removes it.
#
# ICMP uses unprivileged ping sockets, allowed when the service's group is in
# net.ipv4.ping_group_range (the default on most distributions:
# "0 2147483647"). If fyisp logs "ICMP unavailable", either widen that range
# or grant CAP_NET_RAW with a drop-in (sudo systemctl edit fyisp):
#
#   [Service]
#   AmbientCapabilities=CAP_NET_RAW
#   CapabilityBoundingSet=CAP_NET_RAW
#
# To turn on speed tests (or pass any other flag), override ExecStart in a
# drop-in:
#
#   [Service]
#   ExecStart=
#   ExecStart=/usr/local/bin/fyisp --data-dir=${STATE_DIRECTORY} --listen=127.0.0.1:3000 --speedtest
#
# For an HTTPS link through a Cloudflare quick tunnel (see the README's
# "Remote access"), a drop-in can set Environment=FYISP_TUNNEL=1 instead;
# the link is in the journal: sudo journalctl -u fyisp | grep trycloudflare
#
# The dashboard needs an admin token. Without one, fyisp makes a new one at
# every start (signing every browser out) and logs a sign-in link:
#   sudo journalctl -u fyisp | grep -o 'http://[^ "]*#admin=[0-9a-f]*' | tail -1
# To keep one across restarts, put it in a file only root can read (not in
# Environment=, which any user can read with systemctl show):
#   sudo sh -c 'umask 077; echo FYISP_ADMIN_TOKEN=$(openssl rand -hex 16) > /etc/fyisp.env'
# and load it with a drop-in:
#
#   [Service]
#   EnvironmentFile=/etc/fyisp.env
#
# fyisp never logs a token it was given; the sign-in link is then
# http://127.0.0.1:3000/#admin= followed by the token:
#   sudo sed -n 's/^FYISP_ADMIN_TOKEN=//p' /etc/fyisp.env

[Unit]
Description=fyisp internet quality monitor
Documentation=https://github.com/fuck-you-isp/fyisp
# time-sync.target: start after the clock is set (when a time sync service
# provides it, e.g. systemd-timesyncd with systemd-time-wait-sync), so the
# first samples are not stamped with a wrong boot-time clock.
Wants=network-online.target time-sync.target
After=network-online.target time-sync.target

[Service]
Type=simple
ExecStart=/usr/local/bin/fyisp --data-dir=${STATE_DIRECTORY} --listen=127.0.0.1:3000
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15
KillSignal=SIGTERM

DynamicUser=yes
StateDirectory=fyisp
StateDirectoryMode=0700
UMask=0077

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
# No ProcSubset=pid: it hides /proc/net/route (the gateway lookup) and
# /proc/sys (the ICMP hint). ProtectProc=invisible still hides other
# users' processes.
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
