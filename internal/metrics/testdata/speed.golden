# HELP fyisp_speed_download_bits_per_second Download speed of the latest speed test against this server that measured it (iperf3 over IPv4, 8 streams, the ramp-up of up to 1 s left out, 3 to 8 s measured). region is the catalog region the test was for (empty outside mode regions).
# TYPE fyisp_speed_download_bits_per_second gauge
fyisp_speed_download_bits_per_second{region="",server="Leaseweb-Tokyo"} 1.2e+08
fyisp_speed_download_bits_per_second{region="eu-central",server="Eranium-Amsterdam"} 3.9e+08
fyisp_speed_download_bits_per_second{region="uk",server="Clouvider-London"} 4.12e+08
# HELP fyisp_speed_loaded_probes_lost_ratio Share of the latency probes during the latest speed test against this server that got no answer, by layer and direction (load="download" or "upload").
# TYPE fyisp_speed_loaded_probes_lost_ratio gauge
fyisp_speed_loaded_probes_lost_ratio{layer="edge",load="download",region="uk",server="Clouvider-London"} 0.05
fyisp_speed_loaded_probes_lost_ratio{layer="edge",load="upload",region="uk",server="Clouvider-London"} 0
fyisp_speed_loaded_probes_lost_ratio{layer="gateway",load="download",region="uk",server="Clouvider-London"} 0
# HELP fyisp_speed_loaded_rtt_seconds Latency under load of the latest speed test against this server: the median RTT to the ISP edge (layer="edge") or the gateway in the 2 minutes before the test (load="idle") and during the download and the upload (probed every 150 ms; a lost probe counts as the 1 s timeout).
# TYPE fyisp_speed_loaded_rtt_seconds gauge
fyisp_speed_loaded_rtt_seconds{layer="edge",load="download",region="uk",server="Clouvider-London"} 0.021
fyisp_speed_loaded_rtt_seconds{layer="edge",load="idle",region="uk",server="Clouvider-London"} 0.008
fyisp_speed_loaded_rtt_seconds{layer="edge",load="upload",region="uk",server="Clouvider-London"} 0.055
fyisp_speed_loaded_rtt_seconds{layer="gateway",load="download",region="uk",server="Clouvider-London"} 0.0095
fyisp_speed_loaded_rtt_seconds{layer="gateway",load="idle",region="uk",server="Clouvider-London"} 0.0012
# HELP fyisp_speed_tests_total Speed tests since start by server and outcome (ok, busy: the server was running another test, unreachable, failed).
# TYPE fyisp_speed_tests_total counter
fyisp_speed_tests_total{outcome="busy",region="uk",server="Clouvider-London"} 1
fyisp_speed_tests_total{outcome="failed",region="eu-central",server="Eranium-Amsterdam"} 1
fyisp_speed_tests_total{outcome="ok",region="",server="Leaseweb-Tokyo"} 1
fyisp_speed_tests_total{outcome="ok",region="uk",server="Clouvider-London"} 1
fyisp_speed_tests_total{outcome="unreachable",region="",server=""} 1
# HELP fyisp_speed_upload_bits_per_second Upload speed of the latest speed test against this server that measured it.
# TYPE fyisp_speed_upload_bits_per_second gauge
fyisp_speed_upload_bits_per_second{region="",server="Leaseweb-Tokyo"} 1.1e+08
fyisp_speed_upload_bits_per_second{region="uk",server="Clouvider-London"} 4.1e+07
